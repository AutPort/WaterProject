{
  "openapi": "3.0.1",
  "info": {
    "title": "WaterProject.API",
    "version": "1.0"
  },
  "paths": {
    "/Water/AllProjects": {
      "get": {
        "tags": [
          "Water"
        ],
        "parameters": [
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10
            }
          },
          {
            "name": "pageNum",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "projectTypes",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/Water/FunctionalProjects": {
      "get": {
        "tags": [
          "Water"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Project"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Project"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Project"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/Water/GetProjectTypes": {
      "get": {
        "tags": [
          "Water"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Project": {
        "required": [
          "projectName"
        ],
        "type": "object",
        "properties": {
          "projectId": {
            "type": "integer",
            "format": "int32"
          },
          "projectName": {
            "minLength": 1,
            "type": "string"
          },
          "projectType": {
            "type": "string",
            "nullable": true
          },
          "projectRegionalProgram": {
            "type": "string",
            "nullable": true
          },
          "projectImpact": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "projectPhase": {
            "type": "string",
            "nullable": true
          },
          "projectFunctionalityStatus": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}